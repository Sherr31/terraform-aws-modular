# Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plans and crash logs
*.tfplan
crash.log
crash.*.log

# Sensitive Terraform variables
*.tfvars
*.tfvars.json
!*.example.tfvars

# Credentials and private keys
*.pem
*.key
.env
.env.*

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local editor and OS files
.vscode/
.idea/
.DS_Store
/apps/app-two/tfplan
